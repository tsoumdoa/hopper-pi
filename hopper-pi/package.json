{
	"name": "hopper-pi",
	"version": "0.1.0",
	"keywords": [
		"pi-package"
	],
	"type": "module",
	"scripts": {
		"dev": "tsx src/index.ts",
		"build": "tsc -p tsconfig.json",
		"test": "tsx src/tools/query-handlers.search.test.ts",
		"pi": "pi -e .",
		"dump:components": "tsx src/scripts/dump-components.ts"
	},
	"devDependencies": {
		"@types/node": "^20.19.41",
		"tsx": "^4.22.3",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^0.77.0",
		"@earendil-works/pi-coding-agent": "^0.77.0",
		"chalk": "^5.6.2",
		"fast-xml-parser": "^5.8.0",
		"nanoid": "^5.1.11",
		"zeromq": "^6.5.0"
	},
	"pi": {
		"extensions": [
			"./src/index.ts",
			"./mds/extensions"
		],
		"skills": [
			"./mds/skills",
			"./mds/agents"
		],
		"prompts": [
			"./mds/prompts"
		]
	}
}
