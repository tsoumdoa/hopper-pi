<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net7.0-windows;net7.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.rhp</TargetExt>
    <NoWarn>NU1701;NETSDK1086</NoWarn>
    <AssemblyName>Hopper.Rhino</AssemblyName>
    <RootNamespace>rhino_zmq_poc</RootNamespace>
    <Version>0.1.90</Version>
    <Title>Hopper</Title>
    <Company>hoppercode</Company>
    <Description>Private Hopper host launcher and Rhino lifecycle owner</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.0.23304.9001" ExcludeAssets="runtime" />
    <ProjectReference Include="../../dotnet/Hopper.Core/Hopper.Core.csproj" />
    <ProjectReference Include="../../dotnet/Hopper.Rhino.Host/Hopper.Rhino.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="HopperHostManager.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../HostReadiness.cs" Link="HostReadiness.cs" />
    <Compile Include="../operations/RhinoObjectQuery.cs" Link="Operations/RhinoObjectQuery.cs" />
    <Compile Include="../RhinoAgentTransaction.cs" Link="Operations/RhinoAgentTransaction.cs" />
    <Compile Include="../RhinoCodeRunner.cs" Link="Operations/RhinoCodeRunner.cs" />
    <Compile Include="../RhinoCodeRunner.Reflection.cs" Link="Operations/RhinoCodeRunner.Reflection.cs" />
    <Compile Include="../RhinoScriptExecutor.cs" Link="Operations/RhinoScriptExecutor.cs" />
    <Compile Include="../RuntimeManifestPaths.cs" Link="RuntimeManifestPaths.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="rhino-zmq-poc.Tests" />
  </ItemGroup>

</Project>
