{
	"name": "hopper-pi",
	"license": "MIT",
	"version": "0.1.90",
	"description": "Standalone hopper CLI for Grasshopper and Rhino. Experimental CLI port.",
	"type": "module",
	"files": [
		"dist",
		"mds",
		"grasshopper-plugin",
		"scripts"
	],
	"scripts": {
		"dev": "tsx src/cli/main.ts",
		"build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
		"test": "vitest run",
		"dump:components": "tsx src/scripts/dump-components.ts",
		"postinstall": "node scripts/install-grasshopper-plugin.mjs",
		"build:gh-plugin": "node scripts/install-grasshopper-plugin.mjs --build-only",
		"prepack": "npm run build"
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@sinclair/typebox": "^0.34.52",
		"fast-xml-parser": "^5.10.1",
		"nanoid": "^5.1.16",
		"zeromq": "^6.5.0"
	},
	"bin": {
		"hopper": "./dist/cli/main.js"
	}
}
