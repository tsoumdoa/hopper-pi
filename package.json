{
	"name": "hopper-pi",
	"license": "MIT",
	"version": "0.2.0",
	"packageManager": "pnpm@11.5.3",
	"engines": {
		"node": ">=22.19.0"
	},
	"keywords": [
		"pi-package"
	],
	"type": "module",
	"files": [
		"dist",
		"src",
		"mds",
		"dotnet/Hopper.Core",
		"dotnet/Hopper.Grasshopper",
		"dotnet/Hopper.Rhino",
		"scripts"
	],
	"scripts": {
		"dev": "node scripts/ui-mock-host.mjs",
		"build": "node scripts/build.mjs",
		"yak": "node scripts/yak.mjs",
		"version:bump": "node scripts/version-bump.mjs",
		"release": "node scripts/release.mjs",
		"build:install": "node scripts/install-rhino.mjs --yes",
		"test": "vitest run",
		"prepack": "node scripts/build-assets.mjs"
	},
	"devDependencies": {
		"@excalidraw/excalidraw": "^0.18.1",
		"@radix-ui/react-collapsible": "^1.1.20",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@tailwindcss/vite": "^4.3.3",
		"@types/hast": "^3.0.5",
		"@types/node": "^20.19.43",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@types/ws": "8.18.1",
		"@vitejs/plugin-react": "^6.1.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"esbuild": "0.28.1",
		"happy-dom": "^20.14.0",
		"lucide-react": "^1.39.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"zustand": "^5.0.15"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "0.85.1",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@earendil-works/pi-tui": "0.85.1",
		"@lickle/lock": "0.0.1",
		"@napi-rs/keyring": "2.0.0",
		"fast-xml-parser": "^5.11.1",
		"ws": "8.21.3",
		"zeromq": "6.5.0"
	},
	"pi": {
		"extensions": [
			"./src/index.ts",
			"./src/extensions/choices"
		],
		"skills": [
			"./mds/skills",
			"./mds/reference"
		]
	}
}
