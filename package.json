{
	"name": "hopper-pi",
	"description": "Rhino and Grasshopper MCP server with a temporary Pi compatibility adapter",
	"license": "MIT",
	"version": "0.1.90",
	"keywords": [
		"pi-package",
		"mcp-server",
		"model-context-protocol",
		"rhino",
		"grasshopper"
	],
	"type": "module",
	"bin": {
		"hopper-mcp": "dist/mcp/stdio.js"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"dist",
		"!dist/**/*.test.js",
		"!dist/**/*.test.js.map",
		"src",
		"!src/**/*.test.ts",
		"mds",
		"grasshopper-plugin",
		"scripts/install-grasshopper-plugin.mjs",
		"docs/mcp-migration.md",
		"examples/mcp"
	],
	"scripts": {
		"dev": "tsx src/pi/index.ts",
		"clean": "node scripts/clean-dist.mjs",
		"build": "tsc -p tsconfig.json",
		"test": "vitest run",
		"test:mcp:inspector": "node scripts/test-mcp-inspector.mjs",
		"test:pack": "node scripts/test-package.mjs",
		"prepack": "npm run clean && npm run build",
		"pi": "pi -e .",
		"dump:components": "tsx src/scripts/dump-components.ts",
		"postinstall": "node scripts/install-grasshopper-plugin.mjs",
		"build:gh-plugin": "node scripts/install-grasshopper-plugin.mjs --build-only"
	},
	"devDependencies": {
		"@modelcontextprotocol/client": "2.0.0",
		"@modelcontextprotocol/inspector": "2.2.0",
		"@types/node": "^20.19.43",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^0.82.0",
		"@earendil-works/pi-coding-agent": "^0.82.0",
		"@earendil-works/pi-tui": "^0.82.0",
		"@modelcontextprotocol/server": "2.0.0",
		"chalk": "^5.6.2",
		"fast-xml-parser": "^5.10.1",
		"nanoid": "^5.1.16",
		"typebox": "1.1.38",
		"zeromq": "^6.5.0"
	},
	"pi": {
		"extensions": [
			"./src/pi/index.ts",
			"./src/pi/extensions/choices"
		],
		"skills": [
			"./mds/skills",
			"./mds/reference"
		]
	}
}
